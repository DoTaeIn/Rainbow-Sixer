# 디스코드 개발자 포털 > 내 앱  (https://discord.com/developers/applications)
# 이 파일을 .env 로 복사해서 값을 채우세요. .env 는 git 에 올라가지 않습니다.

# General Information > Application ID. 공개값이며 클라이언트 번들에 포함됩니다.
DISCORD_APP_ID=

# OAuth2 > Client Secret. 서버에서만 씁니다. 절대 공개 금지.
DISCORD_CLIENT_SECRET=

# Public Key 는 인터랙션(웹훅) 서명 검증용이라 Activity 에는 필요 없습니다.
# DISCORD_PUBLIC_KEY=
